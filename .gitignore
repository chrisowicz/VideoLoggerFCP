# Never publish user media, private projects or generated FCP documents.
*.[mM][pP]4
*.[mM][oO][vV]
*.[lL][lL][cC]
*.[fF][cC][pP][xX][mM][lL]
*.[fF][cC][pP][xX][mM][lL][dD]/
