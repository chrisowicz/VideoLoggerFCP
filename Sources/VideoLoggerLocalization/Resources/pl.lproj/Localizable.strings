"cli.usage" = "VideoLoggerFCP — lokalny konwerter pojedynczego projektu LosslessCut v2\nUżycie: videologger SOURCE.llc [--media VIDEO.MP4] [--output RESULT.fcpxml]\n                     [--event-name NAME | --event NAME] [--stringout]\nDomyślnie mediaFileName jest szukany obok .llc; wynik powstaje w katalogu .llc.\nNazwa wyniku: SOURCE.fcpxml albo SOURCE-stringout.fcpxml dla --stringout.\n--output wskazuje pełną ścieżkę pliku w innym istniejącym katalogu.\n--event jest zachowanym aliasem --event-name; bez opcji nazwa Eventu pochodzi z .llc.\nKeyword Ranges obejmują wszystkie segmenty. Stringout obejmuje tylko selected=true.\nIstniejące wyniki i pliki źródłowe nigdy nie są nadpisywane.";
"mediaFileName must contain only a filename; use --media for another location." = "mediaFileName musi być samą nazwą pliku; inną lokalizację podaj przez --media.";
"off" = "wyłączony";
"⌘/⇧-click to select multiple recordings and segments. LLC times are checked against exact frames before dragging." = "⌘/⇧-klik: wiele nagrań i segmentów. Czasy LLC; dokładne klatki sprawdzamy dopiero przed przeciągnięciem.";
